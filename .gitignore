# =============================================================================
# Git Ignore — AI Hackathon Repository
# =============================================================================

# --- Environment & Secrets ---
.env
.env.local
.env.production

# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/

# --- Backend ---
backend/target/
backend/*.jar
backend/.mvn/wrapper/maven-wrapper.jar

# --- IDE ---
.vscode/
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# --- OS ---
.DS_Store
Thumbs.db

# --- Docker ---
# Do NOT ignore Dockerfiles or docker-compose.yml
# Only ignore runtime artifacts
docker-compose.override.yml

# --- Redis data (local development only) ---
dump.rdb
appendonly.aof

# --- Logs ---
*.log
logs/
.logs/
