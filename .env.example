# =============================================================================
# AI Hackathon — Environment Configuration Template
# =============================================================================
# Copy this file to .env before running:
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file to version control.
# The .gitignore file excludes .env by default.
# =============================================================================

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Spring Boot Profile
# -----------------------------------------------------------------------------
# Use 'docker' when running via Docker Compose, 'local' for bare-metal dev.
SPRING_PROFILES_ACTIVE=docker

# -----------------------------------------------------------------------------
# Authentication Credentials
# -----------------------------------------------------------------------------
# PoC Basic Auth — change these before any public-facing deployment.
# Limitations: Basic Auth transmits Base64-encoded (not encrypted) credentials.
# In production, migrate to OAuth2/OIDC with TLS termination.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=HackAI2026!
TECH_USERNAME=tech
TECH_PASSWORD=TechField2026!

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis host is resolved via Docker Compose service name ('redis').
# For local dev without Docker, set to 'localhost'.
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379

# -----------------------------------------------------------------------------
# External API Keys
# -----------------------------------------------------------------------------
# NASA POWER API — free, no API key required (rate-limited).
NASA_POWER_API_URL=https://power.larc.nasa.gov/api

# NREL PVWatts API — free API key from https://developer.nrel.gov/signup/
# DEMO_KEY has strict rate limits (30 req/hr). Register for a production key.
NREL_API_KEY=DEMO_KEY

# -----------------------------------------------------------------------------
# Data Persistence Notes
# -----------------------------------------------------------------------------
# Redis data is stored in a Docker named volume ('redis-data').
# - Data survives: docker compose stop, restart, down, up --build
# - Data is LOST on: docker compose down -v (explicit volume removal)
# - Backend file-backed fallback writes to ./data/seed/ inside the container,
#   persisted via the 'backend-data' named volume.
